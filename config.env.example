# VoIP PBX site configuration.
#
# The installer reads /etc/voip-pbx/config.env. On the first run it creates that file from
# this template and fills in generated passwords, so secrets survive re-runs. Edit the
# deployed copy, not this one.
#
#   sudo install -d -m 0750 /etc/voip-pbx
#   sudo install -m 0600 config.env.example /etc/voip-pbx/config.env
#   sudo editor /etc/voip-pbx/config.env

### --- Roles ----------------------------------------------------------------------------
# Which components this machine runs. "all" is the all-in-one case and is simply the
# degenerate form where every role lands on one host and every address below is loopback.
#
# Split across machines by setting this per host and pointing the addresses at real hosts:
#   ROLES="db"            PostgreSQL + Redis
#   ROLES="sip"           Kamailio + rtpengine  (the only internet-facing role)
#   ROLES="media"         FreeSWITCH
#   ROLES="portal"        API + web portal + nginx
#   ROLES="media portal"  FreeSWITCH with a node-local API (recommended - see API_BASE_URL)
ROLES="all"

### --- Component addresses ----------------------------------------------------------------
# All loopback for the all-in-one. Change these when splitting roles across machines.
DB_HOST="127.0.0.1"
DB_PORT=5432
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
FS_HOST="127.0.0.1"
FS_ESL_HOST="127.0.0.1"
FS_ESL_PORT=8021
RTPENGINE_HOST="127.0.0.1"

# Where FreeSWITCH fetches its directory/dialplan/config from via mod_xml_curl. This sits on
# the call path for every registration and every call setup, and mod_xml_curl has NO cache -
# so on a split deployment run an API instance on each media node and keep this loopback,
# rather than putting a network hop and a load balancer in front of call setup.
API_BASE_URL="http://127.0.0.1:3000"

# CIDR the roles use to reach each other. Only consulted when roles are split; the firewall
# opens the internal service ports to this range and nothing else.
INTERNAL_CIDR="127.0.0.1/32"

### --- Identity -------------------------------------------------------------------------
# Public FQDN of this server. Must already resolve to its public IP: Let's Encrypt validates
# over HTTP, and SIP TLS certificates are issued for this name.
PBX_FQDN="pbx.example.com"

# SIP domain presented to endpoints. Often the same as PBX_FQDN.
PBX_SIP_DOMAIN="pbx.example.com"

# Address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL="admin@example.com"

# Set to 1 to use the Let's Encrypt staging CA while testing, so you do not burn rate limits
# on a name that is not ready yet.
LETSENCRYPT_STAGING=0

TIMEZONE="Etc/UTC"

### --- Network --------------------------------------------------------------------------
# CIDRs allowed to reach SSH and the API. Space separated. "0.0.0.0/0" allows the world,
# which you almost certainly do not want for SSH.
ADMIN_ALLOW_CIDR="0.0.0.0/0"

# SIP signalling. Kamailio is the ONLY internet-facing SIP element - for endpoints and for
# carrier trunks alike. FreeSWITCH never talks to a carrier directly and never binds a public
# address; it listens on FS_INTERNAL_SIP_PORT behind Kamailio.
SIP_PORT=5060
SIPS_PORT=5061
FS_INTERNAL_SIP_PORT=5080

# Kamailio's egress listener - the port FreeSWITCH sends outbound calls back to, so Kamailio
# can select the trunk and (later) sign the call. Bound to the internal interface only, never
# exposed. Keeping it distinct from SIP_PORT is what makes the ingress and egress passes
# unambiguous, which matters because Kamailio sees every call twice.
KAM_EGRESS_PORT=5070

# RTP media range handled by rtpengine. Media is relayed on BOTH legs (endpoint<->FreeSWITCH
# and FreeSWITCH<->carrier), so budget ~4 ports per call, not 2. This is also what keeps
# FreeSWITCH's address off the wire entirely.
RTP_PORT_MIN=16384
RTP_PORT_MAX=32768

# SIP over secure WebSocket, for browser clients (the React portal softphone).
# Needs TLS, so 13-tls-certs.sh must have run. Separate port from SIPS so a browser and a
# hardware phone are not sharing a listener.
ENABLE_WEBRTC=1
WSS_PORT=8443

### --- Services ------------------------------------------------------------------------
PG_VERSION=18
API_PORT=3000
API_USER="voipapi"
API_DIR="/opt/voip-api"
WEB_ROOT="/var/www/voip-portal"

# FreeSWITCH source tag to build.
FS_VERSION="v1.11.1"

# Sound rates to install. 8000 for G.711/PSTN, 48000 for Opus.
FS_SOUND_RATES="8000 48000"

### --- STIR/SHAKEN --------------------------------------------------------------------------
# Caller ID attestation, required by the FCC (US) and CRTC (Canada) for outbound PSTN.
# Off by default: it is a source build AND needs a certificate from an STI-CA, which means
# obtaining an OCN and an SPC token from the policy administrator first.
ENABLE_STIR_SHAKEN=0

# EC (prime256v1) signing key and the SP certificate issued with it.
STIR_SHAKEN_KEY="/etc/voip-pbx/stir/signing.key"
STIR_SHAKEN_CERT="/etc/voip-pbx/stir/signing.pem"

# Public HTTPS URL where the certificate above is published. Verifying carriers fetch it to
# check your signature, so it must be reachable from the internet.
STIR_SHAKEN_X5U=""

# Attestation level asserted on calls you originate:
#   A = you authenticated the caller and they own the number
#   B = you authenticated the caller but cannot confirm the number
#   C = the call came from elsewhere; you can only identify the gateway
# Claiming A for traffic you cannot vouch for is a compliance problem.
STIR_SHAKEN_ATTEST="B"

# Origination identifier (UUID) that ties signed calls back to you.
STIR_SHAKEN_ORIGID=""

### --- Fraud and abuse controls -----------------------------------------------------------
# Simultaneous calls allowed per account. The main defence against toll fraud: a stolen
# credential is monetised by placing many international calls at once, and a cap turns an
# overnight five-figure bill into a handful of calls plus an alert. Raise it for call
# centre accounts that genuinely need it.
MAX_CONCURRENT_CALLS=10

# Retention for call detail records, in days. Check what your jurisdiction requires before
# shortening this.
CDR_KEEP_DAYS=365
RECORDING_KEEP_DAYS=90

### --- Secrets --------------------------------------------------------------------------
# Left empty here on purpose. The installer generates strong values on first run and writes
# them back into /etc/voip-pbx/config.env. Set them explicitly only if you are restoring an
# existing deployment and need specific values.
KAMAILIO_DB_PASSWORD=""
KAMAILIO_RO_DB_PASSWORD=""
API_DB_PASSWORD=""
FS_ESL_PASSWORD=""
RTPENGINE_NG_PORT=2223
