# VoIP PBX site configuration.
#
# The installer reads /etc/voip-pbx/config.env. On the first run it creates that file from
# this template and fills in generated passwords, so secrets survive re-runs. Edit the
# deployed copy, not this one.
#
#   sudo install -d -m 0750 /etc/voip-pbx
#   sudo install -m 0600 config.env.example /etc/voip-pbx/config.env
#   sudo editor /etc/voip-pbx/config.env

### --- Identity -------------------------------------------------------------------------
# Public FQDN of this server. Must already resolve to its public IP: Let's Encrypt validates
# over HTTP, and SIP TLS certificates are issued for this name.
PBX_FQDN="pbx.example.com"

# SIP domain presented to endpoints. Often the same as PBX_FQDN.
PBX_SIP_DOMAIN="pbx.example.com"

# Address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL="admin@example.com"

# Set to 1 to use the Let's Encrypt staging CA while testing, so you do not burn rate limits
# on a name that is not ready yet.
LETSENCRYPT_STAGING=0

TIMEZONE="Etc/UTC"

### --- Network --------------------------------------------------------------------------
# CIDRs allowed to reach SSH and the API. Space separated. "0.0.0.0/0" allows the world,
# which you almost certainly do not want for SSH.
ADMIN_ALLOW_CIDR="0.0.0.0/0"

# SIP signalling. Kamailio owns the public ports; FreeSWITCH listens on loopback behind it.
SIP_PORT=5060
SIPS_PORT=5061
FS_INTERNAL_SIP_PORT=5080

# RTP media range handled by rtpengine. Keep it generous - each call uses 2 ports.
RTP_PORT_MIN=16384
RTP_PORT_MAX=32768

### --- Services ------------------------------------------------------------------------
PG_VERSION=18
API_PORT=3000
API_USER="voipapi"
API_DIR="/opt/voip-api"

# FreeSWITCH source tag to build.
FS_VERSION="v1.11.1"

# Sound rates to install. 8000 for G.711/PSTN, 48000 for Opus.
FS_SOUND_RATES="8000 48000"

### --- Secrets --------------------------------------------------------------------------
# Left empty here on purpose. The installer generates strong values on first run and writes
# them back into /etc/voip-pbx/config.env. Set them explicitly only if you are restoring an
# existing deployment and need specific values.
KAMAILIO_DB_PASSWORD=""
KAMAILIO_RO_DB_PASSWORD=""
API_DB_PASSWORD=""
FS_ESL_PASSWORD=""
RTPENGINE_NG_PORT=2223
